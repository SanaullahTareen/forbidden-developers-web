# ===========================================
# FORBIDDEN DEVELOPERS - Environment Config
# ===========================================
# Copy this file to .env and fill in your values
# NEVER commit .env to version control!
# ===========================================

# Server Configuration
NODE_ENV=production
PORT=5000

# MongoDB Connection
# Use a strong, unique password for production
MONGODB_URI=mongodb+srv://username:YOUR_SECURE_PASSWORD@cluster.mongodb.net/forbidden-developers?retryWrites=true&w=majority

# JWT Configuration
# Generate a strong 256-bit secret: openssl rand -hex 64
# Or use: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=YOUR_256_BIT_SECRET_HERE
JWT_EXPIRES_IN=7d

# CORS Configuration
# Comma-separated list of allowed origins
ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com,https://admin.yourdomain.com

# Admin Setup (only used by seedAdmin script)
# Delete these after initial setup!
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=ChangeThisToAStrongPassword123!
ADMIN_NAME=Super Admin

# Email Configuration (for contact forms)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-specific-password
EMAIL_FROM=noreply@yourdomain.com

# File Upload Configuration
MAX_FILE_SIZE=5242880
UPLOAD_PATH=./uploads

# Rate Limiting (requests per window)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Logging
LOG_LEVEL=error
